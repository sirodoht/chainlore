chainlore.xyz {
    root * /var/www/chainlore/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=3600"
    file_server
    handle_errors {
        rewrite * /404/index.html
        file_server
    }
}
