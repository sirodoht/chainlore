chainlore.xyz {
    root * /var/www/chainlore/current
    encode zstd gzip
    # Deferred, so these also cover proxied responses. A leading ? keeps the
    # value Django already set for the forms and admin.
    header {
        X-Content-Type-Options nosniff
        ?Referrer-Policy strict-origin-when-cross-origin
        ?Strict-Transport-Security "max-age=31536000"
        ?X-Frame-Options DENY
        ?Cross-Origin-Opener-Policy same-origin
        # Every script, style, image and request is same-origin; nothing may frame the site.
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
    }
    # Articles moved under /p/ so top-level paths stay free for site pages.
    @legacy path_regexp legacy ^/(bitcoin|ethereum|hyperliquid|arbitrum)/?$
    redir @legacy /p/{re.legacy.1}/ permanent
    # The build links assets by content hash, so a versioned URL never changes.
    @versioned {
        path /assets/*
        query v=*
    }
    @unversioned {
        path /assets/*
        not query v=*
    }
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    header @unversioned Cache-Control "public, max-age=3600"
    @service path /submit /submit/* /admin /admin/*
    handle @service {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:5011 {
            header_up X-Chainlore-IP {remote_host}
        }
    }
    handle_path /service-static/* {
        root * /var/www/chainlore/app-current/staticfiles
        header Cache-Control "public, max-age=3600"
        file_server
    }
    handle {
        file_server
    }
    handle_errors {
        rewrite * /404/index.html
        file_server
    }
}
